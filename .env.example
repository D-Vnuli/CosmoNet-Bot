BOT_TOKEN=YOUR_BOT_TOKEN_HERE
BOT_USERNAME=your_bot_username

ADMIN_IDS=123456789

XUI_BASE_URL=http://your-server-ip:panel-port
XUI_API_TOKEN=your_api_token
XUI_SUB_BASE_URL=http://your-server-ip:panel-port
XUI_INBOUND_ID=3

# Separate 3X-UI inbound for the temporary Telegram authorization VPN.
# Leave disabled until the isolated inbound has a server-side Telegram-only route.
BOOTSTRAP_VPN_ENABLED=false
BOOTSTRAP_XUI_BASE_URL=http://127.0.0.1:2054
BOOTSTRAP_XUI_API_TOKEN=
BOOTSTRAP_XUI_INBOUND_ID=1
BOOTSTRAP_VPN_HOST=
BOOTSTRAP_VPN_SNI=
BOOTSTRAP_REALITY_PUBLIC_KEY=
BOOTSTRAP_REALITY_SHORT_ID=
BOOTSTRAP_WS_XUI_INBOUND_ID=2
BOOTSTRAP_WS_VPN_HOST=
BOOTSTRAP_WS_TLS_SERVER_NAME=
BOOTSTRAP_WS_PATH=/cosmonet-auth
BOOTSTRAP_WS_PORT=10444
BOOTSTRAP_TCP_XUI_INBOUND_ID=3
BOOTSTRAP_TCP_VPN_HOST=
BOOTSTRAP_TCP_TLS_SERVER_NAME=
BOOTSTRAP_TCP_PORT=10445

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://cosmonet.shop/


# РЎС‚РѕРёРјРѕСЃС‚СЊ С‚Р°СЂРёС„РѕРІ РІ Telegram Stars
# Пример: {"123456789":{"promo":3,"lite":2}}
DEVICE_LIMIT_OVERRIDES={}
STARS_PRICE_PROMO=30
STARS_PRICE_LITE=79
STARS_PRICE_STANDARD=119
STARS_PRICE_FAMILY=169

# РљРѕРЅС‚Р°РєС‚ РґР»СЏ РѕР±СЂР°С‰РµРЅРёР№ РїРѕ РїР»Р°С‚РµР¶Р°Рј, РЅР°РїСЂРёРјРµСЂ @username
PAY_SUPPORT_CONTACT=@your_username

# Windows-клиент: бот берёт актуальную версию из HTTPS-манифеста VPS.
COSMONET_WINDOWS_RELEASE_MANIFEST_URL=https://api.example.invalid:18443/downloads/latest.json
COSMONET_WINDOWS_FALLBACK_VERSION=0.2.8
COSMONET_WINDOWS_FALLBACK_DOWNLOAD_URL=https://api.example.invalid:18443/downloads/CosmoNet-Setup-0.2.8.rar

XUI_METADATA_HOST=127.0.0.1
XUI_METADATA_PORT=8091
# Проверка окончания подписок выполняется каждый час.
SUBSCRIPTION_REMINDER_INTERVAL_SECONDS=3600
